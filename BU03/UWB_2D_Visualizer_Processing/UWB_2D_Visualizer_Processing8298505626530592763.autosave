import processing.serial.*;

// ---------- Serial ----------
Serial serialPort;
int serialPortIndex = 8;   // Change if needed after checking console output
int serialBaud = 115200;

// ---------- World / anchors (meters) ----------
float[][] anchors = {
  {0.0, 0.0},
  {4.0, 0.0},
  {4.0, 3.0},
  {0.0, 3.0}
};

// Visible map bounds in meters
float minX = -0.5;
float maxX = 4.5;
float minY = -0.5;
float maxY = 3.5;

// ---------- Live data ----------
float tagX = Float.NaN;
float tagY = Float.NaN;
int anchorsUsed = 0;
float[] d = {0, 0, 0, 0};
boolean hasData = false;

// Trail for smoother visual tracking
ArrayList<PVector> trail = new ArrayList<PVector>();
int maxTrail = 120;

void setup() {
  size(1200, 800);
  smooth(8);

  println("Available serial ports:");
  printArray(Serial.list());

  if (Serial.list().length == 0) {
    println("No serial ports found.");
    return;
  }

  serialPort = new Serial(this, Serial.list()[serialPortIndex], serialBaud);
  serialPort.bufferUntil('\n');
}

void draw() {
  drawBackgroundGrid();
  drawAnchors();
  drawTrail();
  drawTag();
  drawHud();
}

void drawBackgroundGrid() {
  background(18);

  stroke(45);
  strokeWeight(1);

  for (float x = floor(minX); x <= ceil(maxX); x += 0.5) {
    float sx = worldToScreenX(x);
    line(sx, 40, sx, height - 40);
  }

  for (float y = floor(minY); y <= ceil(maxY); y += 0.5) {
    float sy = worldToScreenY(y);
    line(40, sy, width - 40, sy);
  }

  stroke(110);
  strokeWeight(2);
  line(worldToScreenX(0), 40, worldToScreenX(0), height - 40);
  line(40, worldToScreenY(0), width - 40, worldToScreenY(0));
}

void drawAnchors() {
  textAlign(CENTER, CENTER);
  textSize(14);

  for (int i = 0; i < anchors.length; i++) {
    float ax = anchors[i][0];
    float ay = anchors[i][1];

    float sx = worldToScreenX(ax);
    float sy = worldToScreenY(ay);

    // Range ring from current frame
    if (hasData && d[i] > 0.0) {
      noFill();
      stroke(70, 120, 220, 130);
      strokeWeight(1);
      float radiusPx = metersToPixels(d[i]);
      ellipse(sx, sy, radiusPx * 2, radiusPx * 2);
    }

    fill(255, 160, 60);
    noStroke();
    ellipse(sx, sy, 16, 16);

    fill(235);
    text("A" + i, sx, sy - 18);
  }
}

void drawTrail() {
  if (trail.size() < 2) {
    return;
  }

  noFill();
  stroke(120, 220, 120, 180);
  strokeWeight(2);
  beginShape();
  for (PVector p : trail) {
    vertex(worldToScreenX(p.x), worldToScreenY(p.y));
  }
  endShape();
}

void drawTag() {
  if (!hasData || Float.isNaN(tagX) || Float.isNaN(tagY)) {
    return;
  }

  float sx = worldToScreenX(tagX);
  float sy = worldToScreenY(tagY);

  stroke(80, 255, 120);
  strokeWeight(2);
  fill(80, 255, 120);
  ellipse(sx, sy, 14, 14);

  stroke(80, 255, 120, 180);
  line(sx - 10, sy, sx + 10, sy);
  line(sx, sy - 10, sx, sy + 10);
}

void drawHud() {
  fill(255);
  textAlign(LEFT, TOP);
  textSize(15);

  String pos = "Tag: n/a";
  if (hasData && !Float.isNaN(tagX) && !Float.isNaN(tagY)) {
    pos = "Tag: (" + nf(tagX, 1, 3) + ", " + nf(tagY, 1, 3) + ") m";
  }

  text(pos, 20, 12);
  text("Anchors used: " + anchorsUsed, 20, 34);
  text("d0=" + nf(d[0], 1, 3) + "  d1=" + nf(d[1], 1, 3) + "  d2=" + nf(d[2], 1, 3) + "  d3=" + nf(d[3], 1, 3), 20, 56);
}

void serialEvent(Serial p) {
  String line = p.readStringUntil('\n');
  if (line == null) {
    return;
  }

  line = trim(line);
  if (line.length() == 0) {
    return;
  }

  // Ignore non-CSV diagnostic lines
  if (line.startsWith("x,y,anchors_used") || line.startsWith("[status]") || line.startsWith("Header") || line.startsWith("Raw data") || line.startsWith("BS")) {
    return;
  }

  String[] parts = split(line, ',');
  if (parts.length < 7) {
    return;
  }

  try {
    float x = parseFlexibleFloat(parts[0]);
    float y = parseFlexibleFloat(parts[1]);
    int used = int(parseFlexibleFloat(parts[2]));

    float nd0 = parseFlexibleFloat(parts[3]);
    float nd1 = parseFlexibleFloat(parts[4]);
    float nd2 = parseFlexibleFloat(parts[5]);
    float nd3 = parseFlexibleFloat(parts[6]);

    tagX = x;
    tagY = y;
    anchorsUsed = used;
    d[0] = nd0;
    d[1] = nd1;
    d[2] = nd2;
    d[3] = nd3;
    hasData = true;

    if (!Float.isNaN(tagX) && !Float.isNaN(tagY)) {
      trail.add(new PVector(tagX, tagY));
      while (trail.size() > maxTrail) {
        trail.remove(0);
      }
    }
  }
  catch (Exception ex) {
    println("Parse error: " + line);
  }
}

float parseFlexibleFloat(String s) {
  String t = trim(s);
  if (t.equalsIgnoreCase("nan")) {
    return Float.NaN;
  }
  return float(t);
}

float worldToScreenX(float x) {
  return map(x, minX, maxX, 40, width - 40);
}

float worldToScreenY(float y) {
  return map(y, minY, maxY, height - 40, 40);
}

float metersToPixels(float meters) {
  float px0 = worldToScreenX(0);
  float px1 = worldToScreenX(1);
  return abs(px1 - px0) * meters;
}
