{
  "name": "weareu-sender-node",
  "version": "0.1.0",
  "private": true,
  "description": "WeAre.U sender: UWB tracking, game engine, OSC output to VR headsets and browser operator UI.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "weareu-sender": "dist/server/main.js"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/main.ts --web-port 3000",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "sim": "tsx src/server/main.ts --sim",
    "headless": "node dist/server/main.js --headless",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "serialport": "^12.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
