		{"id":"bd108045b39d8b4c","type":"text","text":"# UWB Reader + Trilateration\n- ESP32 recommended (Pico 2 also fine)\n- reads BU03 via UART 115200\n- offsets + least-squares\n- optional Kalman filtering","x":10,"y":-10,"width":330,"height":250},
		{"id":"20b3d22e6265be52","type":"text","text":"BU03 Base 2..7\nfixed anchors","x":500,"y":-270,"width":250,"height":60},
		{"id":"f8c5d2f4a1b64730","type":"text","text":"# Fastest practical path\n- ESP32 -> UART / USB -> Raspberry Pi\n- raw x/y = more immediate, more jitter\n- filtered x/y = smoother, slight lag\n- target >= 20 Hz, about 30-120 ms","x":390,"y":170,"width":390,"height":190},
		{"id":"71a27536e2a399b2","type":"text","text":"# Game Engine\n- Raspberry Pi 4 or 5\n- state logic only, no graphics\n- collisions, field limits, scores, rules","x":-960,"y":100,"width":320,"height":180},
		{"id":"0ced664328eff1da","type":"text","text":"# Player Headset / VR Glasses\n- Raspberry Pi 4 or 5\n- simple 2D bird's-eye view\n- OSC / UDP client over 5 GHz Wi-Fi","x":-690,"y":-810,"width":320,"height":200},
		{"id":"9b9a7a7cdbdcbc5d","type":"text","text":"BU03 Tag\non player","x":-690,"y":-550,"width":250,"height":60},
		{"id":"9fa0f4494f2c4fb0","type":"text","text":"# Spectator Renderer\n- optional outside display node\n- renders game for audience\n- receives OSC / UDP from game engine","x":-600,"y":-295,"width":320,"height":175},
		{"id":"7b1f67f42f3d4a55","type":"text","text":"# Controller Laptop\n- start / stop game\n- sets game length, type, level\n- sends OSC control messages","x":-1360,"y":440,"width":320,"height":160}
	],
